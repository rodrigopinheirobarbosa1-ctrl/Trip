# ---------------------------------------------------------------------------
# Configuração do Trip
#
# Este é o MODELO. O arquivo .env de verdade é criado automaticamente na
# primeira execução de "npm run dev". Na Vercel estas variáveis são
# preenchidas pelo próprio painel (ver README).
# ---------------------------------------------------------------------------

# Endereço do banco PostgreSQL.
DATABASE_URL="postgresql://trip:trip@localhost:5432/trip"

# Mesmo banco, sem "pooler". Usado só para criar/atualizar as tabelas.
# No computador pode ser igual ao de cima.
DATABASE_URL_UNPOOLED="postgresql://trip:trip@localhost:5432/trip"
